        }
        function setStars(arr) { try { localStorage.setItem(KEY, JSON.stringify(arr)); } catch(e){} }
        function paint() {
          var stars = getStars();
          var on = stars.indexOf(entryId) !== -1;
          if (icon) icon.textContent = on ? '★' : '☆';
