    // a specific section of a long entry instead of forcing readers to
    // scroll for the right point. Mirrors GitHub/Notion pattern.
    (function(){
      var heads = document.querySelectorAll('.body h2[id], .body h3[id]');
      if (!heads.length) return;
      heads.forEach(function(h){
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'kn-anchor-btn';
        btn.setAttribute('aria-label', 'Copy section link');
        btn.title = 'Copy link to this section';
        btn.textContent = '#';
        btn.addEventListener('click', function(e){
          e.preventDefault();
          var url = window.location.origin + window.location.pathname + '#' + h.id;
          function flash(ok) {
            btn.textContent = ok ? '✓' : '!';
            btn.style.color = ok ? '#22c55e' : '#EF4444';
            setTimeout(function(){
              btn.textContent = '#';
              btn.style.color = '';
            }, 1100);
          }
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(url).then(function(){ flash(true); }).catch(function(){ flash(false); });
          } else {
            try {
              var ta = document.createElement('textarea');
              ta.value = url;
              ta.style.position = 'fixed';
              ta.style.opacity = '0';
              document.body.appendChild(ta);
              ta.select();
              document.execCommand('copy');
              document.body.removeChild(ta);
              flash(true);
            } catch (_e) { flash(false); }
          }
          history.replaceState(null, '', '#' + h.id);
        });
        h.appendChild(btn);
      });
    })();

