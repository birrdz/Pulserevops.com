        entries.slice(0, MAX_ENTRIES).forEach(function(p){ out[p[0]] = p[1]; });
        return out;
      }
      var map = readMap();
      var prior = map[entryId];
      var banner = document.getElementById('kn-continue');
      var goBtn  = document.getElementById('kn-continue-go');
      var xBtn   = document.getElementById('kn-continue-x');
      var pctEl  = document.getElementById('kn-continue-pct');
      // Show banner if prior position is in [15%, 90%] and <30 days old
      if (banner && prior && typeof prior.pct === 'number'
          && prior.pct >= 15 && prior.pct < 90
          && (Date.now() - (prior.ts || 0)) < THIRTY_DAYS_MS) {
        pctEl.textContent = Math.round(prior.pct) + '%';
        banner.style.display = 'flex';
        requestAnimationFrame(function(){ banner.style.opacity = '1'; });
        var fadeTimer = setTimeout(function(){
          banner.style.opacity = '0';
          setTimeout(function(){ banner.style.display = 'none'; }, 350);
        }, 12000);
        function hide() {
          clearTimeout(fadeTimer);
          banner.style.opacity = '0';
          setTimeout(function(){ banner.style.display = 'none'; }, 350);
        }
        goBtn.addEventListener('click', function(){
          var docH = Math.max(document.body.scrollHeight, document.documentElement.scrollHeight) - window.innerHeight;
          var target = Math.max(0, Math.round(docH * (prior.pct / 100)));
          window.scrollTo({ top: target, behavior: 'smooth' });
          hide();
        });
        xBtn.addEventListener('click', hide);
      }
      // Track new scroll position throughout this page-view; flush on
      // visibility-hidden + before-unload so single-tab navigations also save.
      var lastPct = 0;
      var saveTicking = false;
      function recordCurrent() {
        var docH = Math.max(document.body.scrollHeight, document.documentElement.scrollHeight) - window.innerHeight;
        var y = window.scrollY || window.pageYOffset || 0;
        var pct = docH > 0 ? Math.min(100, Math.max(0, (y / docH) * 100)) : 0;
        lastPct = pct;
        saveTicking = false;
      }
      window.addEventListener('scroll', function(){
        if (!saveTicking) { window.requestAnimationFrame(recordCurrent); saveTicking = true; }
      }, { passive: true });
      function flush() {
        if (lastPct < 2) return; // ignore landings that never scrolled
        var m = readMap();
        m[entryId] = { pct: lastPct, ts: Date.now() };
        writeMap(trim(m));
      }
      document.addEventListener('visibilitychange', function(){
        if (document.visibilityState === 'hidden') flush();
      });
      window.addEventListener('beforeunload', flush);
