  <div id="entry-share" aria-label="Share this entry" style="position:fixed;left:18px;top:50%;transform:translateY(-50%);z-index:35;display:flex;flex-direction:column;gap:6px;background:rgba(10,14,20,0.86);border:1px solid rgba(232,113,10,0.28);border-radius:12px;padding:8px;backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);box-shadow:0 8px 24px rgba(0,0,0,0.4);">
