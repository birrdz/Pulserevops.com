    <div class="meta-row"><span style="display:inline-flex;align-items:center;gap:6px;padding:3px 10px;background:rgba(255,140,26,0.10);border:1px solid rgba(255,140,26,0.35);border-radius:99px;color:#FFB870;font-size:0.66rem;font-weight:800;letter-spacing:0.12em;text-transform:uppercase;" title="Word count of this answer">📖 14,797 words</span><span style="display:inline-flex;align-items:center;gap:6px;padding:3px 10px;background:rgba(123,182,255,0.08);border:1px solid rgba(123,182,255,0.3);border-radius:99px;color:#7BB6FF;font-size:0.66rem;font-weight:800;letter-spacing:0.12em;text-transform:uppercase;" title="Estimated reading time at 220 wpm">⏱ 67 min read</span><span style="margin-left:auto;">5/16/2026</span></div>
