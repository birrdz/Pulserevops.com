    <button class="es-btn" data-act="x" title="Share on X" aria-label="Share on X" style="width:36px;height:36px;border-radius:8px;border:1px solid rgba(232,113,10,0.35);background:transparent;color:#FFB46A;font:800 0.9rem ui-monospace,Menlo,Consolas,monospace;cursor:pointer;transition:background 0.15s,color 0.15s,border-color 0.15s;">𝕏</button>
