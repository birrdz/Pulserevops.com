    <button class="es-btn" data-act="print" title="Print this entry" aria-label="Print this entry" style="width:36px;height:36px;border-radius:8px;border:1px solid rgba(232,113,10,0.35);background:transparent;color:#FFB46A;font-size:1rem;line-height:1;cursor:pointer;transition:background 0.15s,color 0.15s,border-color 0.15s;">🖨</button>
  </div>
  <style>
    #entry-share .es-btn:hover { background: rgba(232,113,10,0.18) !important; color: #FFD740 !important; border-color: rgba(255,215,64,0.6) !important; }
    @media (max-width: 960px){ #entry-share { display: none !important; } }
    @media print { #entry-share { display: none !important; } }
  </style>
  <script>
  (function(){
    var wrap = document.getElementById('entry-share');
    if (!wrap) return;
    var url = window.location.href;
    var title = document.title.replace(/s*·s*Pulse.*$/i, '').trim();
    wrap.addEventListener('click', function(e){
      var b = e.target.closest('.es-btn');
      if (!b) return;
      var act = b.getAttribute('data-act');
      if (act === 'copy') {
        navigator.clipboard.writeText(url).then(function(){
          var orig = b.textContent;
          b.textContent = '✓'; b.style.color = '#39FF14'; b.style.borderColor = '#39FF14';
          setTimeout(function(){ b.textContent = orig; b.style.color = ''; b.style.borderColor = ''; }, 1400);
        });
      } else if (act === 'x') {
        window.open('https://twitter.com/intent/tweet?text=' + encodeURIComponent(title) + '&url=' + encodeURIComponent(url), '_blank', 'noopener,width=600,height=500');
      } else if (act === 'li') {
        window.open('https://www.linkedin.com/sharing/share-offsite/?url=' + encodeURIComponent(url), '_blank', 'noopener,width=600,height=600');
      } else if (act === 'email') {
        window.location.href = 'mailto:?subject=' + encodeURIComponent(title) + '&body=' + encodeURIComponent('Thought this might be useful:

' + url);
      } else if (act === 'print') {
        window.print();
      }
    });
  })();
  </script>

  <!-- t58 — reading progress bar (entry pages) -->
  <div id="rp-bar" aria-hidden="true" style="position:fixed;top:0;left:0;height:3px;width:0;background:linear-gradient(90deg,#E8710A 0%,#FFB04A 60%,#FFE34F 100%);z-index:10000;transition:width 80ms linear;pointer-events:none;box-shadow:0 0 8px rgba(232,113,10,0.55);"></div>
  <style>@media print{#rp-bar{display:none !important;}}</style>
  <script>
    (function(){
      var bar = document.getElementById('rp-bar');
      if (!bar) return;
      var ticking = false;
      function update(){
        var de = document.documentElement;
        var max = (de.scrollHeight - de.clientHeight) || 1;
        var pct = Math.max(0, Math.min(100, (window.pageYOffset / max) * 100));
        bar.style.width = pct.toFixed(2) + '%';
        ticking = false;
      }
      window.addEventListener('scroll', function(){
        if (!ticking) { window.requestAnimationFrame(update); ticking = true; }
      }, { passive: true });
      window.addEventListener('resize', update);
      update();
    })();
  </script>
