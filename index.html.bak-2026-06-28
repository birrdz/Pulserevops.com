  <div class="trip-row">
    <button type="button" class="cta trip" onclick="myPulseLocate(this)">📍 MyPulse — turn on location, we'll tune your PULSE to your area</button>
  </div>
  <script>
  function myPulseLocate(btn){
    if(!navigator.geolocation){ location.href='/trip'; return; }
    var orig = btn.textContent; btn.textContent='📍 Getting your location…';
    navigator.geolocation.getCurrentPosition(function(pos){
      var la=pos.coords.latitude.toFixed(4), lo=pos.coords.longitude.toFixed(4);
      try{ localStorage.setItem('pulse_geo', JSON.stringify({la:la,lo:lo,ts:Date.now()})); }catch(e){}
      location.href='/trip?lat='+la+'&lon='+lo+'&auto=1';
    }, function(){ btn.textContent=orig; location.href='/trip'; }, {enableHighAccuracy:false,timeout:8000,maximumAge:600000});
  }
  </script>
  <div class="cta-row">
    <a href="/knowledge" class="cta primary">📚 Browse the Library</a>
    <a href="/my-content" class="cta ghost">💾 My Content</a>
    <a href="/tools" class="cta ghost">🛠 Free Tools</a>
    <a href="#" class="cta ghost" data-pulse-install>📲 Install the App</a>
  </div>
</section>

