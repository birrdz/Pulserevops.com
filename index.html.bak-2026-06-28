    <a class="pcard" href="/collectibles"><span class="em">🃏</span><span class="pt"><span class="pn">Collectibles</span><span class="pd">Top-10 collectible rankings</span></span></a>
    <a class="pcard" href="/dashboard"><span class="em">📡</span><span class="pt"><span class="pn">Dashboard &amp; CRM</span><span class="pd">Live revenue intel</span></span></a>
    <a class="pcard" href="/dining"><span class="em">🍽️</span><span class="pt"><span class="pn">Dining</span><span class="pd">Top-10 restaurants</span></span></a>
    <a class="pcard" href="/estates"><span class="em">🏡</span><span class="pt"><span class="pn">Estates</span><span class="pd">Luxury real estate</span></span></a>
    <a class="pcard" href="/events"><span class="em">🎟️</span><span class="pt"><span class="pn">Events</span><span class="pd">Festivals &amp; happenings</span></span></a>
