</div>

<!-- HERO — the PULSE logo as the default title -->
<section class="hero">
  <div class="hero-tan">
    <a href="/" class="logo-lockup" aria-label="PULSE home">
      <img class="pulse-fulllogo" src="/pulse-logo.svg" alt="PULSE — We add Value">
    </a>
    <h1 style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0">PULSE — We add value</h1>
  </div>
  <div class="home-search" id="home-search">
    <div class="hs-field">
      <span class="hs-icon">🔍</span>
      <div class="hs-ghost" id="hs-ghost" aria-hidden="true"><span class="g-typed"></span><span class="g-rest"></span></div>
      <input id="hs-input" type="search" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false"
             placeholder="Search 10,000+ answers — keyword or ID (try “best sci-fi movies”, q1946, bt0050)…">
      <button class="hs-clear" id="hs-clear" aria-label="Clear">×</button>
