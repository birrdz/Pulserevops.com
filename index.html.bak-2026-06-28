<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --orange:#E25C29;--od:#C44E1F;--og:rgba(226,92,41,.10);
  --ink:#16161D;--ink2:#55576A;--ink3:#8A8BA0;
  --bg:#EBE9DE;--soft:#FAF8F4;--line:rgba(20,20,30,.10);--lineh:rgba(226,92,41,.45);
  --font:'Plus Jakarta Sans',system-ui,sans-serif;
}
html{scroll-behavior:smooth}
body{font-family:var(--font);color:var(--ink);background:var(--bg);line-height:1.5;overflow-x:hidden;-webkit-font-smoothing:antialiased}

/* slim top bar — keeps auth (sign-in) + advertise working */
.topbar{display:flex;align-items:center;justify-content:space-between;gap:12px;max-width:1180px;margin:0 auto;padding:14px 22px}
.tb-left{display:flex;align-items:center;gap:10px}
.live-pill{display:inline-flex;align-items:center;gap:6px;background:var(--og);border:1px solid rgba(226,92,41,.30);color:var(--orange);font-size:10px;font-weight:800;letter-spacing:1.2px;padding:4px 10px;border-radius:20px}
.ldot{width:6px;height:6px;background:var(--orange);border-radius:50%;animation:blink 1.6s infinite}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.25}}
.tb-right{display:flex;align-items:center;gap:10px}
.tb-ad{display:inline-flex;align-items:center;gap:6px;padding:7px 14px;background:var(--og);border:1px solid rgba(226,92,41,.30);border-radius:99px;color:var(--orange);font-size:11px;font-weight:800;letter-spacing:.05em;text-transform:uppercase;text-decoration:none;transition:background .15s,color .15s}
.tb-ad:hover{background:var(--orange);color:#fff}
.pulse-auth-slot{display:inline-flex;align-items:center;min-height:34px}
.pulse-auth-btn{display:inline-flex;align-items:center;gap:6px;padding:7px 16px;background:var(--orange);border:none;border-radius:99px;color:#fff;font:800 11px/1 var(--font);letter-spacing:.06em;text-transform:uppercase;cursor:pointer;transition:transform .12s,box-shadow .15s;box-shadow:0 2px 10px rgba(226,92,41,.25)}
.pulse-auth-btn:hover{transform:translateY(-1px);box-shadow:0 4px 14px rgba(226,92,41,.4)}
.pulse-userbtn{display:inline-flex;align-items:center}

/* HERO — logo as the title */
.hero{max-width:1300px;margin:0 auto;padding:40px 22px 26px;text-align:center}
@media(min-width:768px){.hero{padding:64px 24px 34px}}
/* Tan hero panel behind the PULSE logo + tagline — matches the pillar landing banners. Same on mobile + desktop. */
.hero-tan{background:#EBE9DE;border-radius:22px;padding:42px 26px 34px;margin:0 auto;max-width:1240px;width:100%}
@media(max-width:560px){.hero-tan{padding:26px 16px 22px;border-radius:16px}}
.logo-lockup{display:inline-flex;align-items:center;gap:18px;justify-content:center}
.logo-lockup img{height:auto;width:auto;display:block}
.logo-lockup img.pulse-fulllogo{display:block;margin:0 auto;width:min(1140px,96vw);height:auto;max-width:100%}
.cta.trip{background:linear-gradient(135deg,#16161D,#2b2b3a);color:#fff;border:1px solid #16161D;box-shadow:0 6px 20px rgba(20,20,30,.28);font-size:15px;padding:14px 26px}
.cta.trip:hover{background:#000;transform:translateY(-1px)}
.trip-row{display:flex;justify-content:center;margin-top:14px}
/* homepage smart search */
.home-search{position:relative;max-width:620px;margin:24px auto 0;text-align:left}
.hs-icon{position:absolute;left:18px;top:50%;transform:translateY(-50%);font-size:16px;opacity:.5;pointer-events:none}
.hs-field{position:relative;background:#fff;border:2px solid var(--line);border-radius:16px;transition:border-color .15s,box-shadow .15s}
.hs-field:focus-within{border-color:var(--orange);box-shadow:0 6px 22px rgba(226,92,41,.14)}
#hs-input{width:100%;background:transparent;border:none;border-radius:16px;padding:16px 44px 16px 46px;font:600 16px var(--font);color:var(--ink);outline:none;position:relative;z-index:2}
#hs-input::-webkit-search-cancel-button{display:none}
.hs-ghost{position:absolute;inset:0;display:flex;align-items:center;padding:0 46px;font:600 16px var(--font);white-space:pre;overflow:hidden;pointer-events:none;z-index:1;color:transparent}
.hs-ghost .g-rest{color:#c2c0bb}
.hs-clear{position:absolute;right:12px;top:50%;transform:translateY(-50%);width:32px;height:32px;border:none;border-radius:99px;background:rgba(20,20,30,.06);color:var(--ink2);font-size:18px;line-height:1;cursor:pointer;display:none;z-index:3}
.hs-sec{padding:9px 16px 5px;font-size:10px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--ink3)}
.hs-row .hs-t mark{background:rgba(226,92,41,.16);color:inherit;border-radius:3px;padding:0 1px;font-weight:800}
.hs-meta{display:flex;align-items:center;gap:7px;flex-shrink:0}
.hs-cat{font-size:10px;font-weight:700;color:var(--ink3);white-space:nowrap}
.hs-hint{display:flex;gap:6px;align-items:center;justify-content:center;padding:9px 12px;border-top:1px solid rgba(20,20,30,.05);font-size:11px;color:var(--ink3);font-weight:600}
.hs-hint kbd{font:inherit;background:var(--soft);border:1px solid var(--line);border-bottom-width:2px;border-radius:5px;padding:1px 6px;font-size:10px;color:var(--ink2)}
.hs-chips{display:flex;flex-wrap:wrap;gap:7px;padding:6px 14px 12px}
.hs-chip{font:inherit;font-size:12px;font-weight:700;background:var(--soft);border:1px solid var(--line);color:var(--ink2);border-radius:99px;padding:6px 12px;cursor:pointer}
.hs-chip:hover{border-color:var(--orange);color:var(--orange)}
.hs-q .hs-t{font-weight:600;color:var(--ink2)}
.hs-dym a{color:var(--orange);font-weight:800;text-decoration:none}
.hs-dym a:hover{text-decoration:underline}
.hs-suggest{position:absolute;left:0;right:0;top:calc(100% + 8px);background:#fff;border:1px solid var(--line);border-radius:14px;box-shadow:0 16px 44px rgba(20,20,30,.16);overflow:hidden;z-index:40;display:none;max-height:62vh;overflow-y:auto}
.hs-suggest.open{display:block}
.hs-row{display:flex;align-items:center;gap:11px;padding:12px 16px;text-decoration:none;color:var(--ink);border-bottom:1px solid rgba(20,20,30,.05);cursor:pointer}
.hs-row:last-child{border-bottom:none}
.hs-row:hover,.hs-row.active{background:var(--soft)}
.hs-row .hs-em{font-size:18px;width:24px;text-align:center;flex-shrink:0}
.hs-row .hs-t{font-size:14px;font-weight:700;line-height:1.25;flex:1;min-width:0}
.hs-row .hs-pill{font-size:10px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;color:var(--orange);background:var(--og);border:1px solid rgba(226,92,41,.25);padding:2px 8px;border-radius:99px;flex-shrink:0}
.hs-empty{padding:16px;color:var(--ink3);font-size:13px;font-weight:600;text-align:center}
.logo-lockup .wordmark{font-size:64px;font-weight:800;letter-spacing:6px;color:var(--orange);line-height:1}
@media(max-width:560px){.hero{padding:30px 18px 22px}.logo-lockup{gap:11px;width:100%}.logo-lockup img.pulse-fulllogo{width:min(580px,94vw)}.hero h1{font-size:clamp(34px,9vw,52px);letter-spacing:-1px;margin-top:20px}.home-search{margin-top:18px}.hero .meta{margin-top:14px}}
.hero h1{margin:20px auto 0;max-width:1100px;font-size:clamp(24px,4vw,46px);font-weight:900;letter-spacing:-1px;line-height:1.1;color:#171E14}
.hero h1 em{font-style:normal;color:#171E14}
.hero p.lead{margin:14px auto 0;max-width:680px;font-size:clamp(14px,1.7vw,16px);color:var(--ink2);line-height:1.6}
.hero .meta{margin-top:16px;display:inline-flex;align-items:center;gap:12px;font-size:12px;color:var(--ink3);font-weight:600;flex-wrap:wrap;justify-content:center}
.hero .meta strong{color:var(--orange);font-weight:800}
.hero .meta .sep{opacity:.4}

/* primary CTAs */
.cta-row{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-top:24px}
.cta{display:inline-flex;align-items:center;gap:7px;padding:12px 22px;border-radius:99px;font-size:13.5px;font-weight:800;letter-spacing:.01em;text-decoration:none;transition:transform .12s,box-shadow .15s,background .15s,border-color .15s;min-height:44px}
.cta.primary{background:var(--orange);color:#fff;border:1px solid var(--orange);box-shadow:0 6px 18px rgba(226,92,41,.28)}
.cta.primary:hover{background:var(--od);transform:translateY(-1px)}
.cta.ghost{background:#fff;color:var(--ink);border:1px solid var(--line)}
.cta.ghost:hover{border-color:var(--lineh);color:var(--orange);transform:translateY(-1px)}

/* PILLAR GRID — the connections */
.pillars{max-width:1100px;margin:6px auto 0;padding:26px 22px 8px}
.pillars h2{text-align:center;font-size:12px;font-weight:800;letter-spacing:1.4px;text-transform:uppercase;color:var(--ink3);margin-bottom:18px}
.pgrid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
@media(min-width:620px){.pgrid{grid-template-columns:repeat(3,1fr)}}
@media(min-width:920px){.pgrid{grid-template-columns:repeat(4,1fr)}}
.pcard{display:flex;align-items:center;gap:12px;padding:16px 16px;background:var(--soft);border:1px solid var(--line);border-radius:16px;text-decoration:none;color:var(--ink);transition:border-color .15s,background .15s,transform .12s,box-shadow .15s}
.pcard:hover{border-color:var(--lineh);background:#fff;transform:translateY(-2px);box-shadow:0 8px 22px rgba(20,20,30,.06)}
.pcard .em{font-size:22px;line-height:1;flex-shrink:0;width:26px;text-align:center}
.pcard .em img{height:26px;width:auto;display:block;margin:0 auto}
.pcard .pt{display:flex;flex-direction:column;gap:2px;min-width:0}
.pcard .pn{font-size:14px;font-weight:800;letter-spacing:-.01em;line-height:1.15}
.pcard .pd{font-size:11px;color:var(--ink3);font-weight:600;line-height:1.3}

/* KORY CRO strip */
.kory{max-width:1100px;margin:30px auto 0;padding:0 22px}
.kory-card{background:var(--soft);border:1px solid var(--line);border-radius:22px;padding:24px 26px;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:22px}
.kory-av{width:64px;height:64px;border-radius:50%;overflow:hidden;flex-shrink:0;border:2px solid rgba(226,92,41,.3);background:linear-gradient(135deg,var(--od),var(--orange));display:flex;align-items:center;justify-content:center;color:#fff;font-weight:900;font-size:24px}
.kory-av img{width:100%;height:100%;object-fit:cover}
.kory-text h3{font-size:16px;font-weight:800;margin-bottom:4px}
.kory-text p{font-size:13px;color:var(--ink2)}
.kory-text .ksub{font-size:11px;color:var(--ink3);margin-top:3px}
.kory-btn{background:var(--orange);color:#fff;font-size:13px;font-weight:800;padding:12px 22px;border-radius:24px;text-decoration:none;white-space:nowrap;transition:background .15s,transform .1s}
.kory-btn:hover{background:var(--od);transform:scale(1.03)}
@media(max-width:680px){.kory-card{grid-template-columns:auto 1fr}.kory-btn{display:none}}

/* FOOTER */
.footer{margin-top:40px;border-top:1px solid var(--line);background:var(--soft);padding:34px 22px 26px}
.ft-in{max-width:1100px;margin:0 auto}
.ft-grid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:36px;margin-bottom:24px}
@media(max-width:720px){.ft-grid{grid-template-columns:1fr;gap:26px}}
.f-logo{display:inline-flex;align-items:center;gap:9px;margin-bottom:9px}
.f-logo img{height:24px}
.f-logo span{font-size:19px;font-weight:800;letter-spacing:2px;color:var(--orange)}
.f-desc{font-size:12px;color:var(--ink2);line-height:1.7;max-width:320px}
.f-disc{font-size:10px;color:var(--ink3);margin-top:10px;line-height:1.5}
.fc h4{font-size:10px;font-weight:800;letter-spacing:1px;text-transform:uppercase;color:var(--ink3);margin-bottom:11px}
.fc a{display:block;font-size:13px;color:var(--ink2);text-decoration:none;margin-bottom:7px;transition:color .15s}
.fc a:hover{color:var(--orange)}
.ft-bot{border-top:1px solid var(--line);padding-top:18px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px;align-items:center}
.f-copy{font-size:11px;color:var(--ink3)}
.f-copy a{color:var(--orange);text-decoration:none}
.lib-pill{display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:700;color:var(--orange);background:var(--og);border:1px solid rgba(226,92,41,.25);padding:6px 14px;border-radius:99px;text-decoration:none}
.lib-pill .d{width:6px;height:6px;background:var(--orange);border-radius:50%;box-shadow:0 0 6px var(--orange)}
/* 50% opacity on pills + pillar tiles (2026-06-21) */
.live-pill,.hs-pill,.lib-pill{opacity:.5}
.pcard{opacity:.5}
.pcard:hover{opacity:1}
.f-seo{font-size:10px;color:var(--ink3);max-width:560px;line-height:1.6;margin-top:12px}
</style>
<script defer src="/pulse-funnel-overlay.js"></script>
</head>
<body>

<!-- slim top bar: sign-in + advertise stay functional -->
<div class="topbar">
  <div class="tb-left"><span class="live-pill"><span class="ldot"></span>LIVE</span></div>
  <div class="tb-right">
    <a href="/sponsor" class="tb-ad">✦ Advertise</a>
    <span data-pulse-auth-slot class="pulse-auth-slot"></span>
