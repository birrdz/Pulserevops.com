```javascript
const { pickGoldTemplate } = require('./_pulse_gold_template_router');

const route = pickGoldTemplate(id, body, title);

await entryScrubPipeline({
  id, title, body, save, sib, out: { steps: [] },
  ui: 'gen', certifyOnPass: true, maxRounds: 6,
});
```

