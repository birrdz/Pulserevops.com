<style>
:root{--bg:#ECE3D2;--ink:#1d1711;--muted:#7a6b54;--amber:#C8821E;--card:#FBF8F1;--line:rgba(29,23,17,.10);
--good:#3C8C3F;--mid:#C8821E;
/* aliases so pulse-search.js styling maps onto the palette */
--orange:#C8821E;--ink2:#7a6b54;--ink3:#9a8a72;--soft:#F3ECDD;--og:rgba(200,130,30,.10);--font:Inter,system-ui,sans-serif;}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:Inter,system-ui,sans-serif;line-height:1.55;-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
h1,h2,h3{font-family:Fraunces,Georgia,serif;font-weight:700}
.wrap{max-width:1080px;margin:0 auto;padding:0 24px;min-height:100dvh;display:flex;flex-direction:column}
/* minimal header */
header{padding:22px 0}
.bar{display:flex;align-items:center}
.brand{display:flex;align-items:center}
.brandlogo{height:62px;width:auto;display:block}
@media(max-width:480px){.brandlogo{height:46px}}
.bar nav{margin-left:auto;display:flex;align-items:center;gap:26px}
.bar nav a{font-size:.9rem;color:var(--muted);font-weight:500}
.bar nav a:hover{color:var(--ink)}
.bar nav a.cta{color:var(--ink);font-weight:600;border-bottom:2px solid var(--amber);padding-bottom:2px}
/* === pulse-search.js styling === */
.home-search{position:relative;max-width:620px;margin:30px auto 0;text-align:left}
.hs-icon{position:absolute;left:18px;top:50%;transform:translateY(-50%);font-size:16px;opacity:.5;pointer-events:none;z-index:2}
.hs-field{position:relative;background:#fff;border:1px solid var(--line);border-radius:16px;transition:border-color .15s,box-shadow .15s}
.hs-field:focus-within{border-color:var(--orange);box-shadow:0 8px 30px rgba(200,130,30,.14)}
#hs-input{width:100%;background:transparent;border:none;border-radius:16px;padding:16px 44px 16px 46px;font:600 16px var(--font);color:var(--ink);outline:none;position:relative;z-index:2}
#hs-input::-webkit-search-cancel-button{display:none}
.hs-ghost{position:absolute;inset:0;display:flex;align-items:center;padding:0 46px;font:600 16px var(--font);white-space:pre;overflow:hidden;pointer-events:none;z-index:1;color:transparent}
.hs-ghost .g-rest{color:#c2bba8}
.hs-clear{position:absolute;right:12px;top:50%;transform:translateY(-50%);width:32px;height:32px;border:none;border-radius:99px;background:rgba(29,23,17,.06);color:var(--ink2);font-size:18px;line-height:1;cursor:pointer;display:none;z-index:3}
.hs-sec{padding:9px 16px 5px;font-size:10px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:var(--ink3)}
.hs-row .hs-t mark{background:rgba(200,130,30,.18);color:inherit;border-radius:3px;padding:0 1px;font-weight:800}
.hs-meta{display:flex;align-items:center;gap:7px;flex-shrink:0}
.hs-cat{font-size:10px;font-weight:700;color:var(--ink3);white-space:nowrap}
.hs-hint{display:flex;gap:6px;align-items:center;justify-content:center;padding:9px 12px;border-top:1px solid rgba(29,23,17,.06);font-size:11px;color:var(--ink3);font-weight:600}
.hs-hint kbd{font:inherit;background:var(--soft);border:1px solid var(--line);border-bottom-width:2px;border-radius:5px;padding:1px 6px;font-size:10px;color:var(--ink2)}
.hs-chips{display:flex;flex-wrap:wrap;gap:7px;padding:6px 14px 12px}
.hs-chip{font:inherit;font-size:12px;font-weight:700;background:var(--soft);border:1px solid var(--line);color:var(--ink2);border-radius:99px;padding:6px 12px;cursor:pointer}
.hs-chip:hover{border-color:var(--orange);color:var(--orange)}
.hs-q .hs-t{font-weight:600;color:var(--ink2)}
.hs-dym a{color:var(--orange);font-weight:800;text-decoration:none}
.hs-suggest{position:absolute;left:0;right:0;top:calc(100% + 8px);background:#fff;border:1px solid var(--line);border-radius:14px;box-shadow:0 16px 44px rgba(29,23,17,.16);overflow:hidden;z-index:40;display:none;max-height:62vh;overflow-y:auto}
.hs-suggest.open{display:block}
.hs-row{display:flex;align-items:center;gap:11px;padding:12px 16px;text-decoration:none;color:var(--ink);border-bottom:1px solid rgba(29,23,17,.05);cursor:pointer}
.hs-row:last-child{border-bottom:none}
.hs-row:hover,.hs-row.active{background:var(--soft)}
.hs-row .hs-em{font-size:18px;width:24px;text-align:center;flex-shrink:0}
.hs-row .hs-t{font-size:14px;font-weight:700;line-height:1.25;flex:1;min-width:0}
.hs-row .hs-pill{font-size:10px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;color:var(--orange);background:var(--og);border:1px solid rgba(200,130,30,.25);padding:2px 8px;border-radius:99px;flex-shrink:0}
.hs-empty{padding:16px;color:var(--ink3);font-size:13px;font-weight:600;text-align:center}
/* hero — search is the one focal point */
.hero{text-align:center;padding:clamp(36px,7vh,72px) 0 14px}
.subline{margin:18px 0 0;font-size:.92rem;color:var(--muted)}
.hero h1{font-size:clamp(2.3rem,5.2vw,3.5rem);font-weight:700;margin:0 auto 30px;line-height:1.08;max-width:14ch;letter-spacing:-.01em}
/* umbrellas — 5 calm tiles, subcategories hidden until opened (progressive disclosure) */
.shelf{margin:clamp(34px,6vh,56px) 0 40px}
.shelf-head{display:flex;align-items:center;justify-content:space-between;margin:0 2px 16px}
.shelf-lbl{font-size:.78rem;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);font-weight:600}
.switch{display:flex;align-items:center;gap:10px;cursor:pointer;-webkit-user-select:none;user-select:none}
.switch-txt{font-size:.85rem;color:var(--muted);font-weight:500}
.switch input{position:absolute;opacity:0;pointer-events:none}
.switch .track{width:40px;height:23px;border-radius:99px;background:rgba(29,23,17,.16);position:relative;transition:background .2s}
.switch .knob{position:absolute;top:3px;left:3px;width:17px;height:17px;border-radius:50%;background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.25);transition:transform .2s}
.switch input:checked + .track{background:var(--amber)}
.switch input:checked + .track .knob{transform:translateX(17px)}
/* full directory (toggle on) */
.alldir{display:none;margin-top:18px;gap:14px;grid-template-columns:1fr;}
.alldir.show{display:grid}
.alldir .ud{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:20px 24px}
.alldir .ud-h{display:flex;align-items:center;gap:11px;margin:0 0 14px}
.alldir .ud-h .ico{font-size:1.3rem}
.alldir .ud-h h3{margin:0;font-size:1.12rem}
.alldir .cols{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:22px}
.alldir .sh{font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;color:var(--amber);font-weight:700;margin:0 0 9px}
.alldir a.lk{display:block;padding:4px 0;font-size:.9rem;font-weight:500}
.alldir a.lk:hover{color:var(--amber)}
.tiles{display:grid;grid-template-columns:repeat(5,1fr);gap:12px}
.tile{background:transparent;border:1px solid var(--line);border-radius:16px;padding:22px 18px;cursor:pointer;text-align:left;transition:background .18s,border-color .18s,transform .18s;font-family:inherit;color:inherit}
.tile:hover{background:var(--card);transform:translateY(-2px)}
.tile.active{background:var(--card);border-color:var(--amber)}
.tile .ico{font-size:1.5rem;display:block;margin-bottom:14px;filter:grayscale(.1)}
.tile h3{margin:0 0 4px;font-size:1.05rem}
.tile .n{font-size:.78rem;color:var(--muted)}
/* reveal panel: one open at a time */
.panel{margin-top:14px;background:var(--card);border:1px solid var(--amber);border-radius:16px;padding:0;max-height:0;overflow:hidden;transition:max-height .3s ease,padding .3s ease}
.panel.open{max-height:1200px;padding:24px 26px}
.panel .cols{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:24px}
.panel .sh{font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;color:var(--amber);font-weight:700;margin:0 0 10px}
.panel a.lk{display:flex;align-items:center;gap:8px;padding:5px 0;font-size:.92rem;font-weight:500;color:var(--ink)}
.panel a.lk:hover{color:var(--amber)}
.panel a.lk .d{font-size:.77rem;color:var(--muted);font-weight:400}
/* the one rich accent: score chips on Buying links */
.score{font-family:Fraunces;font-weight:700;font-size:.72rem;color:#fff;border-radius:6px;padding:2px 6px;line-height:1.2}
.score.good{background:var(--good)}.score.mid{background:var(--mid)}
.foot{margin-top:auto;padding:22px 0 26px;border-top:1px solid var(--line);font-size:.82rem;color:var(--muted);display:flex;gap:12px 18px;flex-wrap:wrap;align-items:center;justify-content:space-between}
.footlinks{display:flex;gap:18px;flex-wrap:wrap}
.footlinks a:hover{color:var(--amber)}
/* trivia champions ticker (scrolling) */
.tk{display:none;align-items:center;margin:0 0 18px;border:1px solid var(--line);background:var(--card);border-radius:12px;overflow:hidden}
.tk.show{display:flex}
.tk-label{flex:0 0 auto;padding:9px 14px;font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;color:var(--amber);font-weight:800;border-right:1px solid var(--line);white-space:nowrap}
.tk-win{flex:1;overflow:hidden}
.tk-track{display:inline-flex;gap:28px;white-space:nowrap;padding-left:28px;animation:tkscroll 30s linear infinite;will-change:transform}
.tk:hover .tk-track{animation-play-state:paused}
.tk-item{font-size:.86rem;font-weight:600;color:var(--ink)}
.tk-item b{color:var(--amber);font-weight:800}
@keyframes tkscroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@media(prefers-reduced-motion:reduce){.tk-track{animation:none}}
@media(max-width:820px){.tiles{grid-template-columns:repeat(2,1fr)}}
@media(max-width:600px){.wrap{padding:0 18px}.bar nav a:not(.cta){display:none}.hero h1{margin-bottom:22px}.home-search{margin-top:20px}.shelf-head{flex-wrap:wrap;gap:10px}}
@media(max-width:420px){.tiles{grid-template-columns:1fr}.foot{flex-direction:column;align-items:flex-start;gap:12px}}
</style>
