<script>
const T = window.PULSE_TAX;
// sample scores on the Buying umbrella (the one rich accent)
const SCORES = {'/cars':96,'/boats':91,'/electronic-reviews':94,'/graphics':92,'/aquariums':83,'/collectibles':90,'/pets':89};

// tiles
document.getElementById('tiles').innerHTML = T.map((c,i)=>{
  const count = c.subs.reduce((n,s)=>n+s.items.length,0);
  return `<button class="tile" data-i="${i}"><span class="ico">${c.ico}</span><h3>${c.name}</h3><span class="n">${count} pillars</span></button>`;
}).join('');

const panel = document.getElementById('panel');
let openIdx = -1;
function renderPanel(i){
  const c = T[i];
  panel.innerHTML = `<div class="cols">${c.subs.map(s=>`
    <div><div class="sh">${s.name}</div>${s.items.map(it=>{
      const sc = (c.id==='buy') ? SCORES[it[1]] : null;
      const chip = sc ? `<span class="score ${sc>=85?'good':'mid'}">${sc}</span>` : '';
      return `<a class="lk" href="${it[1]}">${chip}<span>${it[0]} <span class="d">— ${it[2]}</span></span></a>`;
    }).join('')}</div>`).join('')}</div>`;
}
document.querySelectorAll('.tile').forEach(t=>{
  const i = +t.dataset.i;
  const open = ()=>{ if(openIdx===i){panel.classList.remove('open');document.querySelectorAll('.tile').forEach(x=>x.classList.remove('active'));openIdx=-1;return;}
    renderPanel(i); panel.classList.add('open'); document.querySelectorAll('.tile').forEach(x=>x.classList.toggle('active',+x.dataset.i===i)); openIdx=i; };
  t.addEventListener('click',open);
});

// full directory (toggle on) — real inline content, good for SEO
document.getElementById('alldir').innerHTML = T.map(c=>`
  <div class="ud">
    <div class="ud-h"><span class="ico">${c.ico}</span><h3>${c.name}</h3></div>
    <div class="cols">${c.subs.map(s=>`<div><div class="sh">${s.name}</div>${s.items.map(it=>`<a class="lk" href="${it[1]}">${it[0]}</a>`).join('')}</div>`).join('')}</div>
  </div>`).join('');
const allToggle = document.getElementById('allToggle');
allToggle.addEventListener('change', ()=>{
  const on = allToggle.checked;
  document.getElementById('alldir').classList.toggle('show', on);
  if(on){ panel.classList.remove('open'); document.querySelectorAll('.tile').forEach(x=>x.classList.remove('active')); openIdx=-1; }
});
// default-on: sync the full directory to the (checked) toggle on load
allToggle.dispatchEvent(new Event('change'));

// SEO fallback links (covers the collapsed/default state)
document.getElementById('seolinks').innerHTML = T.map(c=>c.subs.map(s=>s.items.map(it=>`<a href="${it[1]}">${it[0]}</a>`).join('')).join('')).join('');

// Trivia champions ticker — this week's daily winners (scrolling)
(function(){
  fetch('/.netlify/functions/pulse-trivia-score', { cache:'no-store' })
    .then(function(r){ return r.ok ? r.json() : null; })
    .then(function(d){
      var w = (d && d.winners) || [];
      if (!w.length) return;
      var esc = function(s){ var x=document.createElement('div'); x.textContent=s==null?'':s; return x.innerHTML; };
      var items = w.slice(0,7).map(function(x){ return '<span class="tk-item">'+esc(x.day||'')+' — <b>'+esc(x.name)+'</b> ('+ (x.score|0) +')</span>'; });
      if (!items.length) return;
      var track = document.getElementById('tkTrack');
      track.innerHTML = items.join('') + items.join(''); // duplicate for seamless loop
      document.getElementById('triviaTicker').classList.add('show');
    }).catch(function(){});
})();
</script>

